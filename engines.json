        {
          "class": "SharedGLiNERRecognizer",
          "params": {
            "model_name": "urchade/gliner_multi_pii-v1",
            "threshold": 0.4,
            "entity_mapping": {
              "person": "PERSON",
              "organization": "ORGANIZATION",
              "address": "ADDRESS",
              "location": "LOCATION"
            }
          }
        }
      ],
      "en": [
        "AddressRecognizer",
        "LegalFormRecognizer",
        {
          "class": "SharedGLiNERRecognizer",
          "params": {
            "model_name": "urchade/gliner_multi_pii-v1",
            "threshold": 0.4,
            "entity_mapping": {
              "person": "PERSON",
              "organization": "ORGANIZATION",
              "address": "ADDRESS",
              "location": "LOCATION"
            }
          }
        }
      ]
    },
    "remove_recognizers": [
      "SpacyRecognizer"
    ]
  },
