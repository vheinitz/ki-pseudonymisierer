[
  {
    "id": "presidio-gliner",
    "label": "Presidio + GLiNER (Transformer)",
    "nlp_configuration": {
      "nlp_engine_name": "spacy",
      "models": [
        {
          "lang_code": "en",
          "model_name": "en_core_web_sm"
        },
        {
          "lang_code": "de",
          "model_name": "de_core_news_sm"
        }
      ],
      "ner_model_configuration": {
        "model_to_presidio_entity_mapping": {
          "PER": "PERSON",
          "PERSON": "PERSON",
          "NORP": "NRP",
          "FAC": "LOCATION",
          "LOC": "LOCATION",
          "GPE": "LOCATION",
          "ORG": "ORGANIZATION",
          "DATE": "DATE_TIME",
          "TIME": "DATE_TIME"
        },
        "labels_to_ignore": [
          "MISC",
          "CARDINAL",
          "EVENT",
          "LANGUAGE",
          "LAW",
          "MONEY",
          "ORDINAL",
          "PERCENT",
          "PRODUCT",
          "QUANTITY",
          "WORK_OF_ART"
        ],
        "low_score_entity_names": [
          "ORGANIZATION"
        ],
        "low_confidence_score_multiplier": 0.5
      }
    },
    "additional_recognizers": {
      "*": [
        "LabeledValueRecognizer",
        "SensitiveTermsRecognizer",
        "WrittenDateRecognizer",
        "ObfuscatedEmailRecognizer",
        "CreditCardRecognizer",
